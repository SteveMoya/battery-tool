---
/* F16 — Diagnostic Monitor Panel (right side) */
---

<aside
  id="diagnostic-panel"
  class="diag-panel h-full flex flex-col z-20 flex-shrink-0 transition-all duration-300"
  style="background: var(--bg-secondary); border-color: var(--border-primary); border-width: 0 0 0 1px; border-style: solid; box-shadow: -4px 0 20px rgba(0,0,0,0.03);"
>
  <!-- Header -->
  <div class="diag-header flex items-center justify-between px-3 py-2 border-b" style="border-color: var(--border-primary); background: var(--bg-tertiary);">
    <div class="flex items-center gap-1.5">
      <span id="diag-global-status" class="text-lg leading-none">⚪</span>
      <span class="text-[0.72rem] font-extrabold uppercase tracking-wide" style="color: var(--text-tertiary);">Diagnostic</span>
    </div>
    <button
      id="diag-toggle-btn"
      class="diag-collapse-btn transition-colors"
      style="color: var(--text-muted);"
      title="Collapse panel"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Collapsible content -->
  <div id="diag-content" class="diag-content flex-1 overflow-y-auto px-3 py-2">
    <!-- Global Status -->
    <div class="diag-section mb-3">
      <div class="flex items-center justify-between mb-1">
        <span class="text-[0.65rem] font-bold uppercase" style="color: var(--text-muted);">Global Status</span>
        <span id="diag-global-label" class="text-[0.68rem] font-extrabold">NO DATA</span>
      </div>
      <div class="diag-bar-track">
        <div id="diag-global-bar" class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
    </div>

    <div class="border-t border-dashed mb-2" style="border-color: var(--border-primary);"></div>

    <!-- Voltage Sag (F6) — reuses DOM IDs from safety-indicators.ts -->
    <div id="safety-voltage-sag" class="diag-metric mb-2 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Voltage Sag</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">0%</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
      <div class="diag-bar-track mt-1">
        <div class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
      <div class="flex justify-between mt-0.5">
        <span class="text-[0.55rem]" style="color: var(--text-muted);">TTC:</span>
        <span id="safety-time-to-cutoff" class="text-[0.55rem] font-mono" style="color: var(--text-muted);">--</span>
      </div>
    </div>

    <!-- Joule Heat (F16 — NEW) -->
    <div id="safety-joule-heat" class="diag-metric mb-2 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Joule Heat</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">0%</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
      <div class="diag-bar-track mt-1">
        <div class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
    </div>

    <!-- Ampacity (F10a) — reuses DOM ID -->
    <div id="safety-ampacity" class="diag-metric mb-2 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Ampacity</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">0%</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
      <div class="diag-bar-track mt-1">
        <div class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
      <div id="safety-ampacity-recs" class="mt-0.5" style="display:none;"></div>
    </div>

    <!-- Micah Toll (F10b) — reuses DOM ID -->
    <div id="safety-micah" class="diag-metric mb-2 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Strip Safety</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">0%</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
      <div class="diag-bar-track mt-1">
        <div class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
    </div>

    <!-- Strip Thermal (F9) — reuses DOM ID -->
    <div id="safety-strip-thermal" class="diag-metric mb-2 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Strip Thermal</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">N/A</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
    </div>

    <!-- Packing Efficiency (F7) — reuses DOM ID -->
    <div id="safety-packing" class="diag-metric p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Packing Eff.</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">0%</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">N/A</span>
      <div class="diag-bar-track mt-1">
        <div class="diag-bar-fill" style="width: 0%; background: #94a3b8;"></div>
      </div>
    </div>

    <!-- Compliance Status (F1) -->
    <div id="diag-compliance" class="diag-metric p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);" data-level="neutral">
      <div class="flex items-center justify-between mb-0.5">
        <div class="flex items-center gap-1">
          <span class="safety-emoji text-[0.7rem] leading-none">⚪</span>
          <span class="text-[0.65rem] font-bold" style="color: var(--text-primary);">Compliance</span>
        </div>
        <span class="diag-pct text-[0.65rem] font-mono font-bold">N/A</span>
      </div>
      <span class="safety-text text-[0.6rem] font-semibold leading-tight block">Run check to validate</span>
    </div>
  </div>
</aside>

<style>
  .diag-panel {
    width: 240px;
    min-width: 240px;
  }
  .diag-panel.collapsed {
    width: 40px;
    min-width: 40px;
  }
  .diag-panel.collapsed .diag-content {
    display: none;
  }
  .diag-panel.collapsed .diag-header span:not(.text-lg) {
    display: none;
  }
  .diag-panel.collapsed .diag-header {
    padding: 8px 0;
    justify-content: center;
  }
  .diag-collapse-btn {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }
  .diag-collapse-btn:hover {
    background: var(--bg-hover);
  }
  .diag-panel.collapsed .diag-collapse-btn svg {
    transform: rotate(180deg);
  }
  .diag-bar-track {
    width: 100%;
    height: 6px;
    background: var(--border-primary);
    border-radius: 3px;
    overflow: hidden;
  }
  .diag-bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .diag-metric {
    transition: border-color 0.3s ease, color 0.3s ease;
  }
</style>
