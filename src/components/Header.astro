---
---

<header class="header px-3 py-2.5 border-b border-slate-100 bg-white flex items-center justify-between flex-nowrap sticky top-0 z-30 h-[50px] box-content">
  <h1 class="m-0 text-[1rem] text-slate-800 flex items-center gap-1 font-bold flex-shrink whitespace-nowrap overflow-hidden max-[420px]:hidden">
    <span class="text-[1.2em] mr-1">🔋</span>
    <span class="title-text text-slate-800 tracking-[-0.3px]">Pack Architect</span>
    <span class="version-span text-[0.75em] text-slate-400 font-normal ml-0.5 bg-slate-100 px-1.5 py-px rounded inline-block">v85</span>
  </h1>

  <div class="header-actions flex gap-1.5 items-center flex-shrink-0 ml-auto">
    <div class="dropdown">
      <button id="btn-file-menu" class="btn-hamburger" aria-label="File menu">☰</button>
      <div id="file-menu" class="dropdown-content">
        <a href="#" id="menu-import">📂 Import Settings</a>
        <a href="#" id="menu-export">💾 Export Settings</a>
        <a href="#" id="menu-export-stl">
          🧊 Export 3D Model (STL)
          <span class="text-[0.7em] text-slate-400 font-semibold align-middle ml-1">BETA</span>
        </a>
        <a href="#" id="menu-export-step">
          🔧 Export CAD (STEP)
          <span class="text-[0.7em] text-slate-400 font-semibold align-middle ml-1">NEW</span>
        </a>
        <a href="#" id="menu-export-svg">
          📐 Export 2D Projection
          <span class="text-[0.7em] text-slate-400 font-semibold align-middle ml-1">NEW</span>
        </a>
        <a href="#" id="menu-export-bom">
          📋 Bill of Materials
          <span class="text-[0.7em] text-slate-400 font-semibold align-middle ml-1">NEW</span>
        </a>
        <a href="#" id="menu-feedback" class="border-t border-slate-200">💬 Send Feedback</a>
        <a href="#" id="menu-commercial">💼 Commercial Enquiries</a>
        <a href="#" id="menu-license" class="border-t border-slate-200 text-app-red-dark">📜 View License (GPLv3)</a>
        <a href="#" id="menu-disclaimer">⚠️ Safety &amp; Legal</a>
      </div>
    </div>
    <input type="file" id="import-file-input" class="hidden" accept=".json" />
    <a href="https://buymeacoffee.com/lmf5000" target="_blank" rel="noopener" class="no-underline flex-shrink-0">
      <button id="btn-donate" class="btn-donate">☕ Donate</button>
    </a>
    <button id="btn-reset" class="btn-header">Reset</button>
  </div>
</header>
