---
---

<div id="onboarding-overlay" class="onboarding-overlay hidden">
  <div class="onboarding-backdrop"></div>

  <div id="onboarding-card" class="onboarding-card">
    <div class="onboarding-header">
      <div class="onboarding-step-dots" id="onboarding-dots"></div>
      <button id="onboarding-close" class="onboarding-close-btn" aria-label="Close tour">&times;</button>
    </div>

    <div class="onboarding-body">
      <div id="onboarding-icon" class="onboarding-icon"></div>
      <h3 id="onboarding-title" class="onboarding-title"></h3>
      <p id="onboarding-desc" class="onboarding-desc"></p>
    </div>

    <div class="onboarding-footer">
      <button id="onboarding-skip" class="onboarding-btn onboarding-btn-ghost">Skip Tour</button>
      <div class="onboarding-footer-right">
        <button id="onboarding-prev" class="onboarding-btn onboarding-btn-outline" disabled>&larr; Back</button>
        <button id="onboarding-next" class="onboarding-btn onboarding-btn-primary">Next &rarr;</button>
      </div>
    </div>
  </div>
</div>
