---
---

<div id="snapshot-area" class="border-t p-2 px-3 flex flex-col gap-2 flex-shrink-0" style="border-color: var(--border-primary); background: var(--bg-tertiary);">
  <div class="snap-controls flex gap-1.5">
    <button
      id="btn-snap"
      class="btn-action flex-1 py-1.5 rounded text-[0.75rem] font-semibold cursor-pointer text-center bg-app-blue text-white border border-app-blue-dark"
      data-i18n="snapshot.addToCompare"
    >
      + Add to Compare
    </button>
    <button
      id="btn-compare"
      class="btn-action flex-1 py-1.5 rounded text-[0.75rem] font-semibold cursor-pointer text-center border"
      style="background: var(--bg-secondary); border-color: var(--border-primary); color: var(--text-primary);"
      data-i18n-html="snapshot.compareAll"
    >
      Compare All (<span id="snap-count">0</span>)
    </button>
  </div>
  <div id="snap-list" class="flex flex-col gap-1 max-h-[120px] overflow-y-auto"></div>
</div>
