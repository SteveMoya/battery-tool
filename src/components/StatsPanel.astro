---
import HelpIcon from './HelpIcon.astro';
---

<div id="stats-panel" class="flex-shrink-0 py-2.5 px-[15px] bg-white border-t border-slate-200 flex gap-5 z-20">
  <div class="stats-col flex flex-col gap-0.5 justify-center min-w-0 flex-[1.4]">
    <div class="stat-header text-[0.68rem] font-extrabold text-slate-400 uppercase mb-0.5 border-b border-slate-200 pb-0.5">Electrical</div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Config</span>
      <span id="out-config" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-dark">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>
        Strip Length
        <HelpIcon position="right" align="left" width="200px">Excludes inter-layer series connections.</HelpIcon>
        <span id="badge-ladder" class="hidden bg-app-blue text-white text-[8px] px-1 py-px rounded ml-1 font-bold align-middle">LADDER</span>
      </span>
      <span id="out-nickel" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-dark text-[0.75rem]">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Label Rating</span>
      <span id="out-nom-label" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-blue">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>V Range</span>
      <span id="out-v-range" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-gray text-[0.75rem]">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Max Output</span>
      <span id="out-output" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-red">--</span>
    </div>
    <div class="stat-divider border-t border-dashed border-slate-200 my-0.5"></div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>
        Pack Current
        <HelpIcon position="right" align="left" width="180px">Total current through the series string (I). Equal at every series node S1, S2, … SN.</HelpIcon>
      </span>
      <span id="out-pack-current" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-blue">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>
        Cell Current (I/P)
        <HelpIcon position="right" align="left" width="180px">Current through a single cell — total pack current divided by parallel count. Used for cell thermal limits and ampacity.</HelpIcon>
      </span>
      <span id="out-cell-current" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-blue">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Total Energy</span>
      <span id="out-wh" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-purp">--</span>
    </div>
  </div>
  <div class="stats-v-sep w-px bg-slate-100 my-1.5"></div>
  <div class="stats-col flex flex-col gap-0.5 justify-center min-w-0 flex-[0.9]">
    <div class="stat-header text-[0.68rem] font-extrabold text-slate-400 uppercase mb-0.5 border-b border-slate-200 pb-0.5">Physical</div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Length</span>
      <span id="dim-l" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-teal">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Width</span>
      <span id="dim-w" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-teal">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Height</span>
      <span id="dim-h" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-teal">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Volume</span>
      <span id="out-vol" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-pink">--</span>
    </div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Weight</span>
      <span id="out-weight" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-orange">--</span>
    </div>
    <div class="stat-divider border-t border-dashed border-slate-200 my-0.5"></div>
    <div class="stat-row flex justify-between items-baseline text-[0.75rem] leading-snug text-slate-500 font-semibold">
      <span>Cell Cost</span>
      <span id="out-cost" class="val font-bold text-right font-mono tracking-[-0.3px] ml-2 c-green">--</span>
    </div>
  </div>
</div>
