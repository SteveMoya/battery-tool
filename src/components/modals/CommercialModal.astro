<div id="commercial-overlay" class="modal-base-overlay">
  <div
    id="commercial-box"
    class="w-[95%] max-w-[680px] h-[90vh] rounded-lg flex flex-col overflow-hidden shadow-lg"
    style="background: var(--bg-secondary);"
  >
    <div class="modal-header">
      <h3 class="m-0">💼 Commercial Enquiry</h3>
      <button id="btn-close-commercial" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none">×</button>
    </div>
    <div class="p-0 flex-1 overflow-hidden">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSfv3JQ16uyn0WJdmYm4P0709pcOB0JgBwDtLyN4yrFWh87NHg/viewform?embedded=true"
        width="100%"
        height="100%"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
      >Loading…</iframe>
    </div>
  </div>
</div>
