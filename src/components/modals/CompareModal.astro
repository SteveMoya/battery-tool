---
---

<div id="modal-overlay" class="modal-base-overlay">
  <div
    id="comp-modal"
    class="w-[95%] max-w-[900px] max-h-[90vh] rounded-lg shadow-lg flex flex-col"
    style="background: var(--bg-secondary);"
  >
    <div class="modal-header">
      <h3 class="m-0" style="color: var(--text-primary);">Comparison Matrix</h3>
      <button id="btn-close-compare" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none" style="color: var(--text-muted);">×</button>
    </div>
    <div class="modal-body">
      <table class="comp-table">
        <thead><tr id="comp-head-row"><th>Parameter</th></tr></thead>
        <tbody id="comp-body"></tbody>
      </table>
    </div>
  </div>
</div>
