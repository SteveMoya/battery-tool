---
---

<div id="custom-bms-overlay" class="modal-base-overlay">
  <div id="custom-bms-box" class="bg-white w-[90%] max-w-[440px] max-h-[90vh] rounded-lg shadow-[0_20px_50px_rgba(0,0,0,0.5)] flex flex-col">
    <!-- Header -->
    <div class="px-5 py-3 border-b border-slate-200 flex justify-between items-center flex-shrink-0">
      <h3 id="custom-bms-title" class="m-0 text-slate-800 text-[0.95rem]">Custom BMS Configuration</h3>
      <button id="btn-close-custom-bms" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none text-slate-400 hover:text-slate-600">×</button>
    </div>

    <!-- Body -->
    <div class="px-5 py-4 overflow-y-auto flex-1">
      <!-- Name -->
      <div class="flex flex-col mb-3">
        <label class="control-label" for="bms-name-input">Name</label>
        <input id="bms-name-input" type="text" placeholder="e.g. DIY JK-Pareo 14S" class="control-input" />
      </div>

      <!-- Protocol -->
      <div class="flex flex-col mb-3">
        <label class="control-label" for="bms-protocol-input">Protocol</label>
        <select id="bms-protocol-input" class="control-input">
          <option value="Bluetooth">Bluetooth</option>
          <option value="Bluetooth/CAN">Bluetooth/CAN</option>
          <option value="Bluetooth/UART">Bluetooth/UART</option>
          <option value="UART">UART</option>
          <option value="CAN">CAN</option>
          <option value="SMBus">SMBus</option>
          <option value="N/A">N/A</option>
        </select>
      </div>

      <!-- S Count Range -->
      <div class="border border-slate-200 rounded-md p-2.5 mb-3">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-2">S Count Range</div>
        <div class="grid grid-cols-3 gap-2 items-end">
          <div class="flex flex-col">
            <label class="control-label" for="bms-s-min">Min S</label>
            <input id="bms-s-min" type="number" value="8" min="1" max="40" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-s-max">Max S</label>
            <input id="bms-s-max" type="number" value="24" min="1" max="40" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label">&nbsp;</label>
            <label class="flex items-center gap-1.5 cursor-pointer h-[25px]">
              <input id="bms-smart" type="checkbox" checked />
              <span class="text-[0.7rem] font-semibold text-slate-600">Smart</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Electrical -->
      <div class="border border-slate-200 rounded-md p-2.5 mb-3">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-2">Electrical</div>
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col">
            <label class="control-label" for="bms-max-a-input">Max Current (A)</label>
            <input id="bms-max-a-input" type="number" value="60" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-v-cutoff-charge">V Cutoff Charge</label>
            <input id="bms-v-cutoff-charge" type="number" value="4.2" min="0" step="0.05" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-v-cutoff-discharge">V Cutoff Discharge</label>
            <input id="bms-v-cutoff-discharge" type="number" value="2.8" min="0" step="0.05" class="control-input" />
          </div>
        </div>
      </div>

      <!-- Balance Type -->
      <div class="border border-slate-200 rounded-md p-2.5 mb-3">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-2">Balance Type</div>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="pasivo" checked />
            <span class="text-[0.7rem] font-semibold text-slate-600">Passive</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="activo-capacitivo" />
            <span class="text-[0.7rem] font-semibold text-slate-600">Active-Cap</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="activo-inductivo" />
            <span class="text-[0.7rem] font-semibold text-slate-600">Active-Ind</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="sin-balanceo" />
            <span class="text-[0.7rem] font-semibold text-slate-600">None</span>
          </label>
        </div>
      </div>

      <!-- Chemistry -->
      <div class="border border-slate-200 rounded-md p-2.5 mb-3">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-2">Compatible Chemistry</div>
        <div class="flex flex-wrap gap-x-3 gap-y-1">
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-nmc" type="checkbox" checked />
            <span class="text-[0.7rem] font-semibold text-slate-600">NMC</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-lfp" type="checkbox" checked />
            <span class="text-[0.7rem] font-semibold text-slate-600">LFP</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-lto" type="checkbox" />
            <span class="text-[0.7rem] font-semibold text-slate-600">LTO</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-naion" type="checkbox" />
            <span class="text-[0.7rem] font-semibold text-slate-600">Na-Ion</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-nimh" type="checkbox" />
            <span class="text-[0.7rem] font-semibold text-slate-600">NiMH</span>
          </label>
        </div>
      </div>

      <!-- Dimensions -->
      <div class="border border-slate-200 rounded-md p-2.5 mb-3">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-2">Dimensions (mm)</div>
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-w">W</label>
            <input id="bms-dim-w" type="number" value="56" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-d">D</label>
            <input id="bms-dim-d" type="number" value="32" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-h">H</label>
            <input id="bms-dim-h" type="number" value="14" min="1" class="control-input" />
          </div>
        </div>
      </div>

      <!-- Validation Summary -->
      <div id="custom-bms-validation" class="bg-slate-50 border border-slate-200 rounded-md p-2.5 mb-3 hidden">
        <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-1.5 border-b border-slate-200 pb-1">Live Validation</div>
        <div id="custom-bms-val-s" class="flex items-center gap-1.5 mb-1">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold text-slate-600">S Count: --</span>
        </div>
        <div id="custom-bms-val-chem" class="flex items-center gap-1.5 mb-1">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold text-slate-600">Chemistry: --</span>
        </div>
        <div id="custom-bms-val-current" class="flex items-center gap-1.5">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold text-slate-600">MOSFET: --</span>
        </div>
      </div>

      <!-- Warning -->
      <div class="bg-amber-50 border border-amber-300 rounded-md p-2 mb-3">
        <div class="text-[0.65rem] font-semibold text-amber-800 leading-snug">
          ⚠️ Custom BMS — verify datasheet. BCA Tool assumes no responsibility for uncertified hardware.
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-2">
        <div class="flex gap-2">
          <button id="btn-save-custom-bms" class="flex-1 bg-app-blue text-white border-none py-2 rounded-md font-bold text-[0.8rem] cursor-pointer hover:bg-app-blue-dark transition-colors">
            Save
          </button>
          <button id="btn-cancel-custom-bms" class="flex-1 bg-slate-100 text-slate-600 border border-slate-300 py-2 rounded-md font-bold text-[0.8rem] cursor-pointer hover:bg-slate-200 transition-colors">
            Cancel
          </button>
        </div>
        <div class="flex gap-2">
          <button id="btn-export-custom-bms" class="flex-1 bg-slate-100 text-slate-600 border border-slate-300 py-1.5 rounded-md text-[0.7rem] font-semibold cursor-pointer hover:bg-slate-200 transition-colors">
            Export JSON
          </button>
          <button id="btn-import-custom-bms" class="flex-1 bg-slate-100 text-slate-600 border border-slate-300 py-1.5 rounded-md text-[0.7rem] font-semibold cursor-pointer hover:bg-slate-200 transition-colors">
            Import JSON
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden file input for import -->
<input id="bms-import-file" type="file" accept=".json" class="hidden" />
