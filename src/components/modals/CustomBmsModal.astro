---
---

<div id="custom-bms-overlay" class="modal-base-overlay">
  <div id="custom-bms-box" class="w-[90%] max-w-[440px] max-h-[90vh] rounded-lg shadow-lg flex flex-col" style="background: var(--bg-secondary);">
    <!-- Header -->
    <div class="px-5 py-3 border-b flex justify-between items-center flex-shrink-0" style="border-color: var(--border-primary);">
      <h3 id="custom-bms-title" class="m-0 text-[0.95rem]" style="color: var(--text-primary);" data-i18n="modals.customBms.title">Custom BMS Configuration</h3>
      <button id="btn-close-custom-bms" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none" style="color: var(--text-muted);">×</button>
    </div>

    <!-- Body -->
    <div class="px-5 py-4 overflow-y-auto flex-1">
      <!-- Name -->
      <div class="flex flex-col mb-3">
        <label class="control-label" for="bms-name-input" data-i18n="modals.customBms.name">Name</label>
        <input id="bms-name-input" type="text" placeholder="e.g. DIY JK-Pareo 14S" class="control-input" data-i18n-placeholder="modals.customBms.namePlaceholder" />
      </div>

      <!-- Protocol -->
      <div class="flex flex-col mb-3">
        <label class="control-label" for="bms-protocol-input" data-i18n="modals.customBms.protocol">Protocol</label>
        <select id="bms-protocol-input" class="control-input">
          <option value="Bluetooth" data-i18n="modals.customBms.protocolBluetooth">Bluetooth</option>
          <option value="Bluetooth/CAN" data-i18n="modals.customBms.protocolBluetoothCan">Bluetooth/CAN</option>
          <option value="Bluetooth/UART" data-i18n="modals.customBms.protocolBluetoothUart">Bluetooth/UART</option>
          <option value="UART" data-i18n="modals.customBms.protocolUart">UART</option>
          <option value="CAN" data-i18n="modals.customBms.protocolCan">CAN</option>
          <option value="SMBus" data-i18n="modals.customBms.protocolSmbus">SMBus</option>
          <option value="N/A" data-i18n="modals.customBms.protocolNa">N/A</option>
        </select>
      </div>

      <!-- S Count Range -->
      <div class="border rounded-md p-2.5 mb-3" style="border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-2" style="color: var(--text-muted);" data-i18n="modals.customBms.sCountRange">S Count Range</div>
        <div class="grid grid-cols-3 gap-2 items-end">
          <div class="flex flex-col">
            <label class="control-label" for="bms-s-min" data-i18n="modals.customBms.minS">Min S</label>
            <input id="bms-s-min" type="number" value="8" min="1" max="40" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-s-max" data-i18n="modals.customBms.maxS">Max S</label>
            <input id="bms-s-max" type="number" value="24" min="1" max="40" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label">&nbsp;</label>
            <label class="flex items-center gap-1.5 cursor-pointer h-[25px]">
              <input id="bms-smart" type="checkbox" checked />
              <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.smart">Smart</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Electrical -->
      <div class="border rounded-md p-2.5 mb-3" style="border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-2" style="color: var(--text-muted);" data-i18n="modals.customBms.electrical">Electrical</div>
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col">
            <label class="control-label" for="bms-max-a-input" data-i18n="modals.customBms.maxCurrent">Max Current (A)</label>
            <input id="bms-max-a-input" type="number" value="60" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-v-cutoff-charge" data-i18n="modals.customBms.vCutoffCharge">V Cutoff Charge</label>
            <input id="bms-v-cutoff-charge" type="number" value="4.2" min="0" step="0.05" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-v-cutoff-discharge" data-i18n="modals.customBms.vCutoffDischarge">V Cutoff Discharge</label>
            <input id="bms-v-cutoff-discharge" type="number" value="2.8" min="0" step="0.05" class="control-input" />
          </div>
        </div>
      </div>

      <!-- Balance Type -->
      <div class="border rounded-md p-2.5 mb-3" style="border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-2" style="color: var(--text-muted);" data-i18n="modals.customBms.balanceType">Balance Type</div>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="pasivo" checked />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.balancePassive">Passive</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="activo-capacitivo" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.balanceActiveCap">Active-Cap</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="activo-inductivo" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.balanceActiveInd">Active-Ind</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="bms-balance" value="sin-balanceo" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.balanceNone">None</span>
          </label>
        </div>
      </div>

      <!-- Chemistry -->
      <div class="border rounded-md p-2.5 mb-3" style="border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-2" style="color: var(--text-muted);" data-i18n="modals.customBms.compatibleChemistry">Compatible Chemistry</div>
        <div class="flex flex-wrap gap-x-3 gap-y-1">
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-nmc" type="checkbox" checked />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.chemNmc">NMC</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-lfp" type="checkbox" checked />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.chemLfp">LFP</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-lto" type="checkbox" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.chemLto">LTO</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-naion" type="checkbox" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.chemNaIon">Na-Ion</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input id="bms-chem-nimh" type="checkbox" />
            <span class="text-[0.7rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.chemNimh">NiMH</span>
          </label>
        </div>
      </div>

      <!-- Dimensions -->
      <div class="border rounded-md p-2.5 mb-3" style="border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-2" style="color: var(--text-muted);" data-i18n="modals.customBms.dimensionsMm">Dimensions (mm)</div>
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-w" data-i18n="modals.customBms.dimW">W</label>
            <input id="bms-dim-w" type="number" value="56" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-d" data-i18n="modals.customBms.dimD">D</label>
            <input id="bms-dim-d" type="number" value="32" min="1" class="control-input" />
          </div>
          <div class="flex flex-col">
            <label class="control-label" for="bms-dim-h" data-i18n="modals.customBms.dimH">H</label>
            <input id="bms-dim-h" type="number" value="14" min="1" class="control-input" />
          </div>
        </div>
      </div>

      <!-- Validation Summary -->
      <div id="custom-bms-validation" class="border rounded-md p-2.5 mb-3 hidden" style="background: var(--bg-tertiary); border-color: var(--border-primary);">
        <div class="text-[0.68rem] font-extrabold uppercase mb-1.5 border-b pb-1" style="color: var(--text-muted); border-color: var(--border-primary);" data-i18n="modals.customBms.liveValidation">Live Validation</div>
        <div id="custom-bms-val-s" class="flex items-center gap-1.5 mb-1">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.valSCount">S Count: --</span>
        </div>
        <div id="custom-bms-val-chem" class="flex items-center gap-1.5 mb-1">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.valChemistry">Chemistry: --</span>
        </div>
        <div id="custom-bms-val-current" class="flex items-center gap-1.5">
          <span class="custom-val-emoji text-[0.75rem]">⚪</span>
          <span class="custom-val-text text-[0.65rem] font-semibold" style="color: var(--text-tertiary);" data-i18n="modals.customBms.valMosfet">MOSFET: --</span>
        </div>
      </div>

      <!-- Warning -->
      <div class="bg-amber-50 border border-amber-300 rounded-md p-2 mb-3">
        <div class="text-[0.65rem] font-semibold text-amber-800 leading-snug">
          <span data-i18n="modals.customBms.customBmsWarning">⚠️ Custom BMS — verify datasheet. BCA Tool assumes no responsibility for uncertified hardware.</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-2">
        <div class="flex gap-2">
          <button id="btn-save-custom-bms" class="flex-1 bg-app-blue text-white border-none py-2 rounded-md font-bold text-[0.8rem] cursor-pointer hover:bg-app-blue-dark transition-colors">
            <span data-i18n="modals.customBms.save">Save</span>
          </button>
          <button id="btn-cancel-custom-bms" class="flex-1 text-[0.8rem] font-bold cursor-pointer transition-colors" style="background: var(--bg-quaternary); color: var(--text-tertiary); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 0.5rem;">
            <span data-i18n="modals.customBms.cancel">Cancel</span>
          </button>
        </div>
        <div class="flex gap-2">
          <button id="btn-export-custom-bms" class="flex-1 text-[0.7rem] font-semibold cursor-pointer transition-colors" style="background: var(--bg-quaternary); color: var(--text-tertiary); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 0.375rem;">
            <span data-i18n="modals.customBms.exportJson">Export JSON</span>
          </button>
          <button id="btn-import-custom-bms" class="flex-1 text-[0.7rem] font-semibold cursor-pointer transition-colors" style="background: var(--bg-quaternary); color: var(--text-tertiary); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 0.375rem;">
            <span data-i18n="modals.customBms.importJson">Import JSON</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden file input for import -->
<input id="bms-import-file" type="file" accept=".json" class="hidden" />
