<div id="feedback-overlay" class="modal-base-overlay">
  <div
    id="feedback-box"
    class="bg-white w-[95%] max-w-[680px] h-[90vh] rounded-lg flex flex-col overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
  >
    <div class="modal-header">
      <h3 class="m-0">💬 Send Feedback</h3>
      <button id="btn-close-feedback" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none">×</button>
    </div>
    <div class="p-0 flex-1 overflow-hidden">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLScuvfCD_0sT5DStfZDcY9APwgVrCBqT-htn_F9dNEbg99aKeQ/viewform?embedded=true"
        width="100%"
        height="100%"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
      >Loading…</iframe>
    </div>
  </div>
</div>
