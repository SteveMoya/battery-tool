---
---

<div id="license-overlay" class="modal-base-overlay" style="z-index:9998">
  <div
    id="license-box"
    class="w-[90%] max-w-[800px] max-h-[85vh] rounded-lg flex flex-col p-0 shadow-lg"
    style="background: var(--bg-secondary);"
  >
    <div class="modal-header">
      <h3 class="m-0" data-i18n="modals.license.title">GNU General Public License v3.0</h3>
      <button id="btn-close-license" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none">×</button>
    </div>
    <div
      id="license-content"
      class="p-5 overflow-y-auto font-mono text-[0.75rem] whitespace-pre-wrap text-[#333]"
      style="background: var(--bg-tertiary);"
      data-loaded="false"
    >
      <span data-i18n="modals.license.loading">Loading License text...</span> (If this takes too long, view it here: https://www.gnu.org/licenses/gpl-3.0.txt)
    </div>
  </div>
</div>
