---

<div id="license-overlay" class="modal-base-overlay" style="z-index:9998">
  <div
    id="license-box"
    class="bg-white w-[90%] max-w-[800px] max-h-[85vh] rounded-lg flex flex-col p-0 shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
  >
    <div class="modal-header">
      <h3 class="m-0">GNU General Public License v3.0</h3>
      <button id="btn-close-license" class="border-none bg-none text-[1.5rem] cursor-pointer leading-none">×</button>
    </div>
    <div
      id="license-content"
      class="p-5 overflow-y-auto font-mono text-[0.75rem] whitespace-pre-wrap bg-slate-50 text-[#333]"
      data-loaded="false"
    >
      Loading License text... (If this takes too long, view it here: https://www.gnu.org/licenses/gpl-3.0.txt)
    </div>
  </div>
</div>
