---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">12. Cell Balancing</h2>
    <HelpIcon tip="Active vs passive balancing: equalization time, energy loss, and BMS cost impact" />
  </div>

  <div class="mb-2">
    <div class="flex items-center gap-2 mb-1.5">
      <button
        id="balancing-run-btn"
        class="btn-primary text-[0.65rem] py-1 px-2.5"
      >
        Analyze Balancing
      </button>
      <span id="balancing-status-badge" class="text-[0.6rem] font-bold px-1.5 py-0.5 rounded hidden"></span>
    </div>

    <!-- Inputs -->
    <div id="balancing-inputs" class="rounded-md p-2 mb-2" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
      <div class="grid grid-cols-2 gap-2">
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Balancing Current (mA)</label>
          <input id="balancing-current" type="number" value="200" min="10" max="2000" step="10"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">MOSFET RDS(ohm)</label>
          <input id="balancing-mosfet-rds" type="number" value="0.1" min="0.01" max="5" step="0.01"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Target SoC Spread (%)</label>
          <input id="balancing-soc-spread" type="number" value="5" min="1" max="20" step="1"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Cost per Channel (EUR)</label>
          <input id="balancing-channel-cost" type="number" value="1.5" min="0.5" max="20" step="0.5"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
      </div>
    </div>

    <div id="balancing-results"></div>
  </div>
</section>
