---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">6. BMS Bounding Box</h2>
    <HelpIcon tip="Visualize the selected BMS enclosure in 3D attached to the pack face" />
  </div>

  <div class="toggle-row mb-2">
    <label for="bms-box-visible" class="cursor-pointer">Show BMS Box</label>
    <input id="bms-box-visible" type="checkbox" />
  </div>

  <div id="bms-box-dims" class="hidden">
    <!-- BMS Dimensions (read-only from selected BMS) -->
    <div id="bms-box-info" class="rounded-md p-2 mb-2" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
      <div class="text-[0.65rem] font-bold uppercase mb-1 tracking-wide" style="color: var(--text-muted);">BMS Dimensions</div>
      <div id="bms-box-dims-text" class="text-[0.72rem] font-mono font-semibold" style="color: var(--text-primary);">Select a BMS in section 5</div>
    </div>

    <!-- Position: 6 faces -->
    <div class="text-[0.65rem] font-bold uppercase mb-1 tracking-wide" style="color: var(--text-muted);">
      Position
      <HelpIcon position="right" width="180px" align="left">
        <strong>BMS Position</strong><br />
        Place the BMS box against one of the 6 faces of the battery pack.
      </HelpIcon>
    </div>
    <div class="grid grid-cols-3 gap-1 mb-2">
      <button id="bms-pos-top" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Top</button>
      <button id="bms-pos-bottom" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Bottom</button>
      <div></div>
      <button id="bms-pos-left" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Left</button>
      <button id="bms-pos-right" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Right</button>
      <div></div>
      <button id="bms-pos-front" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Front</button>
      <button id="bms-pos-back" type="button" class="bms-pos-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">Back</button>
      <div></div>
    </div>
    <input id="bms-box-position" type="hidden" value="right" />

    <!-- Rotation -->
    <div class="text-[0.65rem] font-bold uppercase mb-1 tracking-wide" style="color: var(--text-muted);">
      Rotation
      <HelpIcon position="right" width="180px" align="left">
        <strong>BMS Rotation</strong><br />
        Rotate the BMS box 90° to swap its width and depth orientation on the pack face.
      </HelpIcon>
    </div>
    <div class="grid grid-cols-2 gap-1 mb-2">
      <button id="bms-rot-left" type="button" class="bms-rot-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">⟲ Rotate Left</button>
      <button id="bms-rot-right" type="button" class="bms-rot-btn px-2 py-1.5 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-tertiary); border-width: 1px; border-style: solid;">⟳ Rotate Right</button>
    </div>
    <input id="bms-box-rotation" type="hidden" value="0" />

    <!-- Offset from pack edge -->
    <div class="flex items-center justify-between mb-1">
      <span class="text-[0.65rem] font-bold uppercase tracking-wide" style="color: var(--text-muted);">Gap from Pack Edge</span>
      <HelpIcon position="left" width="200px" align="right">
        <strong>Gap from Pack Edge</strong><br />
        Distance (mm) between the pack face and the BMS box. Increase to add clearance for wires or connectors.
      </HelpIcon>
    </div>
    <div class="flex flex-col mb-2">
      <input id="bms-box-offset" type="number" value="5" min="0" step="1" class="control-input" />
    </div>

    <!-- Interference Status -->
    <div id="bms-box-interference" class="hidden rounded-md p-2 mt-1 border">
      <div class="flex items-center gap-1.5">
        <span id="bms-box-interference-emoji" class="text-[0.85rem]">🟢</span>
        <span id="bms-box-interference-text" class="text-[0.68rem] font-bold">No interference</span>
      </div>
    </div>
  </div>
</section>

<style>
  .bms-pos-btn.active, .bms-rot-btn.active {
    background-color: color-mix(in srgb, var(--accent-primary) 10%, transparent);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
</style>
