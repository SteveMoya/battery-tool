---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">5. BMS Selection</h2>
    <HelpIcon tooltip="Battery Management System selector with auto-validation" />
  </div>

  <div class="flex flex-col">
    <label class="control-label" for="bms-selector">BMS Model</label>
    <select id="bms-selector" class="control-input">
      <option value="auto">Auto-Recommend</option>
      <option value="none">No BMS (manual)</option>
    </select>
  </div>

  <!-- Custom BMS Actions -->
  <div class="flex gap-1.5 mt-1.5">
    <button id="btn-add-custom-bms" class="text-[0.6rem] font-bold px-2 py-0.5 rounded bg-app-blue-light text-app-blue-dark border border-app-blue-dark hover:bg-app-blue-dark hover:text-white transition-colors cursor-pointer">+ Add Custom BMS</button>
    <button id="btn-edit-custom-bms" class="text-[0.6rem] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-500 border border-slate-300 hover:bg-slate-200 transition-colors cursor-pointer hidden">Edit</button>
    <button id="btn-dup-custom-bms" class="text-[0.6rem] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-500 border border-slate-300 hover:bg-slate-200 transition-colors cursor-pointer hidden">Duplicate</button>
    <button id="btn-del-custom-bms" class="text-[0.6rem] font-bold px-2 py-0.5 rounded bg-red-50 text-red-500 border border-red-300 hover:bg-red-100 transition-colors cursor-pointer hidden">Delete</button>
  </div>

  <!-- F13: BMS Position Offset -->
  <div id="bms-offset-row" class="flex gap-2 mt-1.5 hidden">
    <div class="flex-1">
      <label class="control-label" for="bms-offset-x">Offset X (mm)</label>
      <input id="bms-offset-x" type="number" class="control-input text-[0.65rem]" value="0" step="5" />
    </div>
    <div class="flex-1">
      <label class="control-label" for="bms-offset-y">Offset Y (mm)</label>
      <input id="bms-offset-y" type="number" class="control-input text-[0.65rem]" value="0" step="5" />
    </div>
    <div class="flex-1">
      <label class="control-label" for="bms-offset-z">Offset Z (mm)</label>
      <input id="bms-offset-z" type="number" class="control-input text-[0.65rem]" value="0" step="5" />
    </div>
  </div>

  <!-- F13: Interference Warning -->
  <div id="bms-interference" class="bg-red-50 border border-red-400 rounded-md p-2 mt-1.5 hidden">
    <div class="flex items-center gap-1.5">
      <span class="text-[0.85rem]">🔴</span>
      <span id="bms-interference-text" class="text-[0.65rem] font-bold text-red-700">BMS box intersects pack — adjust offset</span>
    </div>
  </div>

  <!-- BMS Info Card -->
  <div id="bms-info" class="bg-slate-50 border border-slate-200 rounded-md p-2 mt-2 hidden">
    <div class="flex justify-between items-center mb-1">
      <span id="bms-name" class="text-[0.72rem] font-extrabold text-slate-700">--</span>
      <span id="bms-badge" class="text-[0.55rem] font-bold px-1.5 py-0.5 rounded bg-slate-200 text-slate-600">--</span>
    </div>
    <div class="grid grid-cols-2 gap-x-3 gap-y-0.5 text-[0.62rem]">
      <span class="text-slate-500">S Range</span>
      <span id="bms-s-range" class="font-mono font-semibold text-slate-700">--</span>
      <span class="text-slate-500">Chemistry</span>
      <span id="bms-chem" class="font-mono font-semibold text-slate-700">--</span>
      <span class="text-slate-500">MOSFET</span>
      <span id="bms-max-a" class="font-mono font-semibold text-slate-700">--</span>
      <span class="text-slate-500">Balance</span>
      <span id="bms-balance" class="font-mono font-semibold text-slate-700">--</span>
      <span class="text-slate-500">Protocol</span>
      <span id="bms-protocol" class="font-mono font-semibold text-slate-700">--</span>
      <span class="text-slate-500">Dimensions</span>
      <span id="bms-dims" class="font-mono font-semibold text-slate-700">--</span>
    </div>
  </div>

  <!-- Validation Vectors (F12) -->
  <div id="bms-validation" class="bg-slate-50 border border-slate-200 rounded-md p-2 mt-2 hidden">
    <div class="text-[0.68rem] font-extrabold text-slate-400 uppercase mb-1.5 border-b border-slate-200 pb-1">Validation</div>

    <div id="bms-val-s" class="bms-val-row flex items-start gap-1.5 mb-1.5 p-1.5 rounded border border-slate-200 bg-white" style="color: #94a3b8; border-color: #94a3b8;">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold text-slate-700">S Count Match</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>

    <div id="bms-val-chem" class="bms-val-row flex items-start gap-1.5 mb-1.5 p-1.5 rounded border border-slate-200 bg-white" style="color: #94a3b8; border-color: #94a3b8;">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold text-slate-700">Chemistry</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>

    <div id="bms-val-current" class="bms-val-row flex items-start gap-1.5 p-1.5 rounded border border-slate-200 bg-white" style="color: #94a3b8; border-color: #94a3b8;">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold text-slate-700">MOSFET Margin</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>
  </div>

  <!-- Recommendation Summary -->
  <div id="bms-recommendation" class="bg-app-green-light border border-app-green-dark rounded-md p-2 mt-2 hidden">
    <div class="flex items-center gap-1.5">
      <span class="text-[0.85rem]">✅</span>
      <span id="bms-rec-text" class="text-[0.68rem] font-bold text-app-green-dark">--</span>
    </div>
  </div>

  <!-- Warning for manual/none BMS -->
  <div id="bms-warning" class="bg-app-orange-light border border-app-orange-dark rounded-md p-2 mt-2 hidden">
    <div class="flex items-center gap-1.5">
      <span class="text-[0.85rem]">⚠️</span>
      <span id="bms-warning-text" class="text-[0.68rem] font-bold text-app-orange-dark">--</span>
    </div>
  </div>
</section>

<!-- F11b: Custom BMS Modal -->
<div id="bms-modal-overlay" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center">
  <div class="bg-white rounded-lg border border-slate-300 shadow-xl w-[420px] max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center px-4 py-2.5 border-b border-slate-200">
      <h3 id="bms-modal-title" class="text-sm font-bold text-slate-700">Add Custom BMS</h3>
      <button id="bms-modal-close" class="text-slate-400 hover:text-slate-700 text-lg leading-none">&times;</button>
    </div>
    <div class="px-4 py-3 flex flex-col gap-2.5">
      <div class="text-[0.55rem] text-orange-600 bg-orange-50 border border-orange-200 rounded px-2 py-1">
        ⚠️ BMS Custom — verify datasheet; BCA Tool assumes no responsibility for uncertified hardware
      </div>

      <div>
        <label class="control-label" for="bms-f-name">Name</label>
        <input id="bms-f-name" type="text" class="control-input" placeholder="e.g. DIY JK-Pareo 14S" />
      </div>
      <div>
        <label class="control-label" for="bms-f-brand">Brand</label>
        <input id="bms-f-brand" type="text" class="control-input" placeholder="e.g. Custom" />
      </div>

      <div class="flex gap-2">
        <div class="flex-1">
          <label class="control-label" for="bms-f-smin">S Min</label>
          <input id="bms-f-smin" type="number" class="control-input" min="1" value="8" />
        </div>
        <div class="flex-1">
          <label class="control-label" for="bms-f-smax">S Max</label>
          <input id="bms-f-smax" type="number" class="control-input" min="1" value="24" />
        </div>
      </div>

      <div class="flex gap-2">
        <div class="flex-1">
          <label class="control-label" for="bms-f-maxa">Max Current (A)</label>
          <input id="bms-f-maxa" type="number" class="control-input" min="1" value="60" />
        </div>
        <div class="flex-1">
          <label class="control-label" for="bms-f-balance">Balance Type</label>
          <select id="bms-f-balance" class="control-input">
            <option value="pasivo">Passive</option>
            <option value="activo-capacitivo">Active (Capacitive)</option>
            <option value="activo-inductivo">Active (Inductive)</option>
            <option value="sin-balanceo">No Balance</option>
          </select>
        </div>
      </div>

      <div>
        <label class="control-label">Chemistry (leave unchecked = any)</label>
        <div class="flex flex-wrap gap-2 mt-0.5">
          <label class="flex items-center gap-1 text-[0.62rem] text-slate-600 cursor-pointer"><input type="checkbox" class="bms-chem-check" value="li-ion" /> Li-Ion</label>
          <label class="flex items-center gap-1 text-[0.62rem] text-slate-600 cursor-pointer"><input type="checkbox" class="bms-chem-check" value="lfp" /> LFP</label>
          <label class="flex items-center gap-1 text-[0.62rem] text-slate-600 cursor-pointer"><input type="checkbox" class="bms-chem-check" value="lto" /> LTO</label>
          <label class="flex items-center gap-1 text-[0.62rem] text-slate-600 cursor-pointer"><input type="checkbox" class="bms-chem-check" value="na-ion" /> Na-Ion</label>
          <label class="flex items-center gap-1 text-[0.62rem] text-slate-600 cursor-pointer"><input type="checkbox" class="bms-chem-check" value="nimh" /> NiMH</label>
        </div>
      </div>

      <div class="flex gap-2">
        <div class="flex-1">
          <label class="control-label" for="bms-f-vcharge">V Cutoff Charge</label>
          <input id="bms-f-vcharge" type="number" class="control-input" step="0.01" value="4.2" />
        </div>
        <div class="flex-1">
          <label class="control-label" for="bms-f-vdischarge">V Cutoff Discharge</label>
          <input id="bms-f-vdischarge" type="number" class="control-input" step="0.01" value="2.8" />
        </div>
      </div>

      <div class="flex gap-2">
        <div class="flex-1">
          <label class="control-label" for="bms-f-w">Width (mm)</label>
          <input id="bms-f-w" type="number" class="control-input" min="1" value="50" />
        </div>
        <div class="flex-1">
          <label class="control-label" for="bms-f-d">Depth (mm)</label>
          <input id="bms-f-d" type="number" class="control-input" min="1" value="30" />
        </div>
        <div class="flex-1">
          <label class="control-label" for="bms-f-h">Height (mm)</label>
          <input id="bms-f-h" type="number" class="control-input" min="1" value="12" />
        </div>
      </div>

      <div class="flex gap-2">
        <div class="flex-1">
          <label class="control-label" for="bms-f-protocol">Protocol</label>
          <select id="bms-f-protocol" class="control-input">
            <option value="Bluetooth">Bluetooth</option>
            <option value="UART">UART</option>
            <option value="CAN">CAN</option>
            <option value="SMBus">SMBus</option>
            <option value="N/A">N/A</option>
          </select>
        </div>
        <div class="flex items-end pb-0.5">
          <label class="flex items-center gap-1.5 text-[0.62rem] text-slate-600 cursor-pointer">
            <input id="bms-f-smart" type="checkbox" checked /> Smart (Programmable S)
          </label>
        </div>
      </div>
    </div>

    <div class="px-4 py-2.5 border-t border-slate-200 flex justify-end gap-2">
      <button id="bms-modal-cancel" class="text-[0.65rem] font-bold px-3 py-1 rounded bg-slate-100 text-slate-600 border border-slate-300 hover:bg-slate-200 cursor-pointer">Cancel</button>
      <button id="bms-modal-save" class="text-[0.65rem] font-bold px-3 py-1 rounded bg-app-blue-light text-app-blue-dark border border-app-blue-dark hover:bg-app-blue-dark hover:text-white cursor-pointer">Save</button>
    </div>
  </div>
</div>
