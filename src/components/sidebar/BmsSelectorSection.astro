---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0" data-i18n="sidebar.bms.title">5. BMS Selection</h2>
    <HelpIcon tip="Battery Management System selector with auto-validation" />
  </div>

  <div class="flex flex-col">
    <label class="control-label" for="bms-selector" data-i18n="sidebar.bms.bmsModel">BMS Model</label>
    <select id="bms-selector" class="control-input">
      <option value="auto" data-i18n="sidebar.bms.autoRecommend">Auto-Recommend</option>
      <option value="none" data-i18n="sidebar.bms.noBms">No BMS (manual)</option>
    </select>
  </div>

  <!-- Custom BMS Actions (shown when custom BMS selected) -->
  <div id="bms-custom-actions" class="flex gap-1.5 mt-1.5 hidden">
    <button id="btn-edit-custom-bms" type="button" class="flex-1 py-1 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="background: var(--bg-quaternary); color: var(--text-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;" data-i18n="sidebar.bms.edit">Edit</button>
    <button id="btn-dup-custom-bms" type="button" class="flex-1 py-1 rounded text-[0.65rem] font-semibold cursor-pointer transition-colors" style="background: var(--bg-quaternary); color: var(--text-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;" data-i18n="sidebar.bms.duplicate">Duplicate</button>
    <button id="btn-del-custom-bms" type="button" class="flex-1 bg-red-50 text-red-600 border border-red-200 py-1 rounded text-[0.65rem] font-semibold cursor-pointer hover:bg-red-100 transition-colors" data-i18n="sidebar.bms.delete">Delete</button>
  </div>

  <!-- BMS Info Card -->
  <div id="bms-info" class="rounded-md p-2 mt-2 hidden" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
    <div class="flex justify-between items-center mb-1">
      <span id="bms-name" class="text-[0.72rem] font-extrabold" style="color: var(--text-primary);">--</span>
      <span id="bms-badge" class="text-[0.55rem] font-bold px-1.5 py-0.5 rounded" style="background: var(--bg-quaternary); color: var(--text-tertiary);">--</span>
    </div>
    <div class="grid grid-cols-2 gap-x-3 gap-y-0.5 text-[0.62rem]">
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.sRange">S Range</span>
      <span id="bms-s-range" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.chemistry">Chemistry</span>
      <span id="bms-chem" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.mosfet">MOSFET</span>
      <span id="bms-max-a" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.balance">Balance</span>
      <span id="bms-balance" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.protocol">Protocol</span>
      <span id="bms-protocol" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
      <span style="color: var(--text-tertiary);" data-i18n="sidebar.bms.dimensions">Dimensions</span>
      <span id="bms-dims" class="font-mono font-semibold" style="color: var(--text-primary);">--</span>
    </div>
  </div>

  <!-- Validation Vectors (F12) -->
  <div id="bms-validation" class="rounded-md p-2 mt-2 hidden" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
    <div class="text-[0.68rem] font-extrabold uppercase mb-1.5 border-b pb-1" style="color: var(--text-muted); border-color: var(--border-primary);" data-i18n="sidebar.bms.validation">Validation</div>

    <div id="bms-val-s" class="bms-val-row flex items-start gap-1.5 mb-1.5 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold" style="color: var(--text-primary);" data-i18n="sidebar.bms.sCountMatch">S Count Match</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>

    <div id="bms-val-chem" class="bms-val-row flex items-start gap-1.5 mb-1.5 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold" style="color: var(--text-primary);" data-i18n="sidebar.bms.valChemistry">Chemistry</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>

    <div id="bms-val-current" class="bms-val-row flex items-start gap-1.5 p-1.5 rounded border" style="color: #94a3b8; border-color: var(--border-primary); background: var(--bg-secondary);">
      <span class="bms-val-emoji text-[0.75rem] leading-none mt-px">⚪</span>
      <div class="flex-1 min-w-0">
        <span class="text-[0.68rem] font-bold" style="color: var(--text-primary);" data-i18n="sidebar.bms.mosfetMargin">MOSFET Margin</span>
        <span class="bms-val-text text-[0.65rem] font-semibold leading-tight block">N/A</span>
      </div>
    </div>
  </div>

  <!-- Recommendation Summary -->
  <div id="bms-recommendation" class="bg-app-green-light border border-app-green-dark rounded-md p-2 mt-2 hidden">
    <div class="flex items-center gap-1.5">
      <span class="text-[0.85rem]">✅</span>
      <span id="bms-rec-text" class="text-[0.68rem] font-bold text-app-green-dark">--</span>
    </div>
  </div>

  <!-- Warning for manual/none BMS -->
  <div id="bms-warning" class="bg-app-orange-light border border-app-orange-dark rounded-md p-2 mt-2 hidden">
    <div class="flex items-center gap-1.5">
      <span class="text-[0.85rem]">⚠️</span>
      <span id="bms-warning-text" class="text-[0.68rem] font-bold text-app-orange-dark">--</span>
    </div>
  </div>
</section>
