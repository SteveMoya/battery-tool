---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0" data-i18n="sidebar.breaker.title">9. Protection & Disconnect</h2>
    <HelpIcon tip="Recommends contactors, breakers, disconnects, and precharge resistors based on pack voltage and current" data-i18n-tip="sidebar.breaker.helpTip" />
  </div>

  <div class="mb-2">
    <div class="flex items-center gap-2 mb-1.5">
      <button
        id="protection-run-btn"
        class="btn-primary text-[0.65rem] py-1 px-2.5"
      >
        <span data-i18n="sidebar.breaker.recommendProtection">Recommend Protection</span>
      </button>
      <span id="protection-status-badge" class="text-[0.6rem] font-bold px-1.5 py-0.5 rounded hidden"></span>
    </div>

    <div id="protection-summary" class="rounded-md p-2 mb-2" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
      <div class="text-[0.62rem] font-semibold" style="color: var(--text-muted);">
        Click "Recommend Protection" to see which components are needed for your pack.
      </div>
    </div>

    <div id="protection-results"></div>
  </div>

  <details class="mt-2">
    <summary class="text-[0.65rem] font-bold cursor-pointer" style="color: var(--text-muted);" data-i18n="sidebar.breaker.refTitle">Protection Reference</summary>
    <div class="mt-1 space-y-1">
      <div class="flex items-start gap-1.5 text-[0.55rem]">
        <span class="font-extrabold" style="color: #ef4444;" data-i18n="sidebar.breaker.contactorName">Contactor</span>
        <span class="text-slate-500" data-i18n="sidebar.breaker.contactorDesc">— Required for >60V or >200A for remote disconnection</span>
      </div>
      <div class="flex items-start gap-1.5 text-[0.55rem]">
        <span class="font-extrabold" style="color: #3b82f6;" data-i18n="sidebar.breaker.breakerName">Breaker</span>
        <span class="text-slate-500" data-i18n="sidebar.breaker.breakerDesc">— Overcurrent protection with manual reset</span>
      </div>
      <div class="flex items-start gap-1.5 text-[0.55rem]">
        <span class="font-extrabold" style="color: #8b5cf6;" data-i18n="sidebar.breaker.disconnectName">Disconnect</span>
        <span class="text-slate-500" data-i18n="sidebar.breaker.disconnectDesc">— LOTO (Lock-Out/Tag-Out) for maintenance safety</span>
      </div>
      <div class="flex items-start gap-1.5 text-[0.55rem]">
        <span class="font-extrabold" style="color: #f59e0b;" data-i18n="sidebar.breaker.prechargeName">Precharge</span>
        <span class="text-slate-500" data-i18n="sidebar.breaker.prechargeDesc">— Limits inrush current for packs >48V with contactors</span>
      </div>
      <div class="flex items-start gap-1.5 text-[0.55rem]">
        <span class="font-extrabold" style="color: #ec4899;" data-i18n="sidebar.breaker.fuseName">Fuse</span>
        <span class="text-slate-500" data-i18n="sidebar.breaker.fuseDesc">— Last line of defense — sizing validated against I_max</span>
      </div>
    </div>
  </details>
</section>
