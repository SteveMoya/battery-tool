---
---

<section class="group-box">
  <h2 class="section-title" data-i18n="sidebar.chemistry.title">2. Chemistry &amp; Voltage</h2>
  <div class="control-item full-width mb-2">
    <label class="control-label" data-i18n="sidebar.chemistry.chemistry">Chemistry</label>
    <div class="flex gap-1">
      <select id="chem-selector" class="control-input flex-1"><option value="custom" data-i18n="sidebar.chemistry.customVoltage">Custom Voltage</option></select>
      <button id="btn-save-preset-chem" class="btn-icon" title="Save" data-i18n-title="sidebar.chemistry.save">💾</button>
      <button id="btn-del-preset-chem" class="btn-icon" title="Delete" data-i18n-title="sidebar.chemistry.delete" disabled>🗑️</button>
    </div>
  </div>
  <div class="grid grid-cols-3 gap-1.5 items-end">
    <div class="flex flex-col">
      <label class="control-label" for="c-min-v" data-i18n="sidebar.chemistry.minV">Min (V)</label>
      <input id="c-min-v" type="number" value="2.5" step="0.1" class="control-input" />
    </div>
    <div class="flex flex-col">
      <label class="control-label" for="c-volts" data-i18n="sidebar.chemistry.nomV">Nom (V)</label>
      <input id="c-volts" type="number" value="3.6" step="0.1" class="control-input" />
    </div>
    <div class="flex flex-col">
      <label class="control-label" for="c-max-v" data-i18n="sidebar.chemistry.maxV">Max (V)</label>
      <input id="c-max-v" type="number" value="4.2" step="0.1" class="control-input" />
    </div>
  </div>
  <div
    id="chem-warning"
    class="hidden mt-1.5 text-[0.65rem] leading-snug text-amber-800 bg-amber-50 border border-amber-200 rounded px-2 py-1"
  ></div>
</section>
