---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">13. Degradation & Cycle Life</h2>
    <HelpIcon tip="Capacity fade prediction, calendar life estimation, and cost-per-cycle analysis" />
  </div>

  <div class="mb-2">
    <div class="flex items-center gap-2 mb-1.5">
      <button
        id="degradation-run-btn"
        class="btn-primary text-[0.65rem] py-1 px-2.5"
      >
        Analyze Degradation
      </button>
      <span id="degradation-status-badge" class="text-[0.6rem] font-bold px-1.5 py-0.5 rounded hidden"></span>
    </div>

    <!-- Inputs -->
    <div id="degradation-inputs" class="rounded-md p-2 mb-2" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
      <div class="grid grid-cols-2 gap-2">
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Operating Temp (°C)</label>
          <input id="degradation-temp" type="number" value="30" min="0" max="60" step="1"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Avg C-rate</label>
          <input id="degradation-crate" type="number" value="1" min="0.1" max="5" step="0.1"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Avg DoD (%)</label>
          <input id="degradation-dod" type="number" value="80" min="10" max="100" step="5"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Cycles per Year</label>
          <input id="degradation-cycles-yr" type="number" value="365" min="1" max="1000" step="1"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Pack Cost (EUR)</label>
          <input id="degradation-cost" type="number" value="500" min="0" max="100000" step="50"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Chemistry</label>
          <select id="degradation-chemistry" class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);">
            <option value="nmc">NMC</option>
            <option value="lfp">LFP</option>
            <option value="lto">LTO</option>
            <option value="na-ion">Na-Ion</option>
            <option value="nca">NCA</option>
          </select>
        </div>
      </div>
    </div>

    <div id="degradation-results"></div>
  </div>
</section>
