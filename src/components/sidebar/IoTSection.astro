---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">16. IoT & Monitoring</h2>
    <HelpIcon tip="Generate monitoring configurations for MQTT, Modbus, CAN — Home Assistant, Grafana, ThingsBoard" />
  </div>

  <div class="mb-2">
    <div class="flex items-center gap-2 mb-1.5">
      <button
        id="iot-run-btn"
        class="btn-primary text-[0.65rem] py-1 px-2.5"
      >
        Generate Config
      </button>
      <span id="iot-status-badge" class="text-[0.6rem] font-bold px-1.5 py-0.5 rounded hidden"></span>
    </div>

    <!-- Inputs -->
    <div id="iot-inputs" class="rounded-md p-2 mb-2" style="background: var(--bg-tertiary); border-color: var(--border-primary); border-width: 1px; border-style: solid;">
      <div class="grid grid-cols-2 gap-2">
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Protocol</label>
          <select id="iot-protocol" class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);">
            <option value="mqtt">MQTT</option>
            <option value="modbus">Modbus TCP</option>
            <option value="can">CAN Bus</option>
          </select>
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Sample Rate (s)</label>
          <input id="iot-sample-rate" type="number" value="5" min="0.1" max="300" step="0.5"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
        <div class="flex flex-col">
          <label class="text-[0.58rem] font-bold mb-0.5" style="color: var(--text-muted);">Temp Sensors</label>
          <input id="iot-temp-sensors" type="number" value="4" min="1" max="64" step="1"
            class="text-[0.65rem] px-1.5 py-1 rounded border" style="border-color: var(--border-primary); background: var(--bg-secondary); color: var(--text-primary);" />
        </div>
      </div>
    </div>

    <div id="iot-results"></div>
  </div>
</section>
