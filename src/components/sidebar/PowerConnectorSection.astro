---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">7. Power Connectors</h2>
    <HelpIcon tooltip="Connector & cable guide — recommends connectors, wire gauge, fuse, and BMS wiring based on your pack config" />
  </div>

  <div class="grid grid-cols-2 gap-2 mb-2">
    <div class="flex flex-col">
      <label class="control-label" for="conn-cable-length">Cable Length</label>
      <div class="smart-input-wrap">
        <input id="conn-cable-length" type="number" value="30" min="5" max="500" step="5" class="control-input" />
        <span class="unit">cm</span>
      </div>
    </div>
    <div class="flex flex-col">
      <label class="control-label" for="conn-application">Application</label>
      <select id="conn-application" class="control-input">
        <option value="general">General</option>
        <option value="ebike">E-Bike</option>
        <option value="powerwall">Powerwall</option>
        <option value="ev">Electric Vehicle</option>
        <option value="drone">Drone / UAV</option>
      </select>
    </div>
  </div>

  <!-- Input summary -->
  <div id="conn-input-summary" class="bg-slate-50 border border-slate-200 rounded-md p-2 mb-2">
    <div class="text-[0.62rem] text-slate-400 font-semibold">
      Configure pack &amp; load in sections 1–4 to see recommendations.
    </div>
  </div>

  <!-- Connector recommendation (populated by JS) -->
  <div id="conn-connector-card"></div>

  <!-- BMS wiring info (populated by JS) -->
  <div id="conn-bms-wiring"></div>

  <!-- Connector Reference Table (always visible) -->
  <details class="mt-2">
    <summary class="text-[0.65rem] font-bold text-slate-500 cursor-pointer hover:text-slate-700">📋 Connector Reference Table</summary>
    <div class="mt-1 overflow-x-auto">
      <table class="w-full text-[0.58rem] border-collapse">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="text-left py-0.5 px-1 text-slate-500 font-semibold">Type</th>
            <th class="text-right py-0.5 px-1 text-slate-500 font-semibold">Cont.</th>
            <th class="text-right py-0.5 px-1 text-slate-500 font-semibold">Burst</th>
            <th class="text-right py-0.5 px-1 text-slate-500 font-semibold">mΩ</th>
            <th class="text-right py-0.5 px-1 text-slate-500 font-semibold">AWG</th>
          </tr>
        </thead>
        <tbody id="conn-ref-table-body">
        </tbody>
      </table>
    </div>
  </details>
</section>
