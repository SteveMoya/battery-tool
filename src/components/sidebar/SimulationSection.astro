---
import HelpIcon from '../HelpIcon.astro';
---

<section class="group-box">
  <div class="flex justify-between items-center mb-1.5">
    <h2 class="section-title m-0">4. Simulation &amp; Efficiency</h2>
  </div>

  <details>
    <summary>⚙️ Click for Advanced Strip Parameters</summary>
    <div class="px-2.5 py-2.5 border-t border-slate-200">
      <div class="flex flex-col">
        <label class="control-label">Strip Material</label>
        <select id="sim-strip-mat" class="control-input">
          <option value="7.0">Nickel (7.0×10⁻⁸ Ωm)</option>
          <option value="14.0">Steel (1.4×10⁻⁷ Ωm)</option>
          <option value="1.7">Copper (1.7×10⁻⁸ Ωm)</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-2 mt-1.5 items-end">
        <div class="flex flex-col">
          <label class="control-label" for="sim-strip-w">Width (mm)</label>
          <input id="sim-strip-w" type="number" value="7.0" class="control-input" />
        </div>
        <div class="flex flex-col">
          <label class="control-label" for="sim-strip-t">Thick (mm)</label>
          <input id="sim-strip-t" type="number" value="0.15" step="0.05" class="control-input" />
        </div>
      </div>
    </div>
  </details>

  <input type="hidden" id="sim-mode-val" value="discharge" />
  <input type="hidden" id="sim-load-type" value="cc" />

  <div class="bg-slate-50 border border-slate-200 p-2 rounded-md mb-2">
    <div class="control-item full-width mb-2">
      <label class="flex justify-between mb-0.5">
        <span>Current SoC (Starting Point)</span>
        <span id="val-soc" class="font-bold text-app-green font-mono text-[0.75rem]">100%</span>
      </label>
      <div class="flex items-center gap-2">
        <input
          id="sim-soc"
          type="range"
          min="0"
          max="100"
          value="100"
          step="1"
          class="flex-1 h-[5px] rounded appearance-none"
          style="background: linear-gradient(90deg, #ef4444 0%, #eab308 50%, #22c55e 100%);"
        />
        <div class="smart-input-wrap w-[85px]">
          <input id="sim-cell-volt-input" type="number" step="0.01" />
          <span class="unit">V</span>
        </div>
      </div>
    </div>

    <div class="flex justify-between items-end mb-1">
      <div class="flex flex-col">
        <span class="text-[0.7rem] font-bold text-slate-600 mb-0.5 flex items-center">
          Load
          <HelpIcon position="right" width="240px" align="left">
            <strong>Slider Limits</strong>
            <ul class="pl-3 my-1 text-left">
              <li class="mb-1.5">
                <strong>Discharge (Stress Test Simulation):</strong>
                <div class="pl-2 mt-0.5 text-slate-300 font-normal">
                  • <strong>Amps:</strong> Up to 150% of rated current.<br />
                  • <strong>Watts:</strong> Includes 150% Overpower capability. Scaled to Max Voltage (4.2V/cell) for peak burst simulation.
                </div>
              </li>
              <li><strong>Charge:</strong> Up to 5C (Ultra Fast Charge).</li>
            </ul>
          </HelpIcon>
        </span>
        <div id="toggle-load-type" class="inline-toggle">
          <span class="it-opt active" data-val="cc">Amps</span>
          <span class="it-opt" data-val="cp">Watts</span>
        </div>
      </div>
      <div class="text-right">
        <div id="lbl-sim-c" class="text-[0.7rem] text-slate-500 font-bold">0.00 C</div>
        <div id="lbl-load-perc" class="text-[0.65rem] text-slate-400 font-semibold">0% of max current</div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <input id="sim-load-slider" type="range" min="0" max="1000" value="0" step="1" class="flex-1 h-[5px]" />
      <div class="smart-input-wrap w-[85px]">
        <input id="sim-load-input" type="number" value="0" step="0.1" />
        <span id="sim-input-unit" class="unit">A</span>
      </div>
    </div>
  </div>

  <div id="sim-results" class="grid grid-cols-[1.1fr_1px_0.9fr] gap-0 bg-white border border-slate-200 rounded-md p-0 mt-2 overflow-visible">
    <div class="res-col p-1.5 px-2.5 flex flex-col gap-0.5">
      <div class="flex justify-between items-center mb-1 pb-1 border-b border-slate-100">
        <span class="res-lbl text-slate-700 font-semibold text-[0.68rem]">Mode:</span>
        <div id="toggle-sim-mode" class="inline-toggle">
          <span class="it-opt active warn" data-val="discharge">Disch</span>
          <span class="it-opt" data-val="charge">Chg</span>
        </div>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span id="lbl-sim-sag" class="res-lbl text-slate-500 font-semibold text-[0.68rem] flex items-center">
          Sag
          <HelpIcon position="right" align="left">
            <strong>Voltage Sag (Ohmic)</strong><br />
            Immediate voltage drop due to internal resistance (DCIR) and busbar resistance.
          </HelpIcon>
        </span>
        <span id="out-sim-sag" class="res-val font-mono font-bold text-[0.75rem] tracking-[-0.3px] c-red">0.00 V</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span id="lbl-sim-net" class="res-lbl text-slate-500 font-semibold text-[0.68rem] flex items-center">Net Output</span>
        <span id="out-sim-netv" class="res-val font-mono font-bold text-[0.75rem] tracking-[-0.3px] c-blue">0.0 V</span>
      </div>
      <div id="row-lvc-inputs" class="mt-1 pt-1 border-t border-dashed border-slate-100">
        <div class="flex justify-between items-center mt-0.5">
          <span class="res-lbl text-slate-500 font-semibold text-[0.68rem] flex items-center">
            LVC (Cell)
            <HelpIcon position="right" align="left">
              <strong>Low Voltage Cutoff</strong><br />
              The safe minimum voltage limit. Simulation stops if the cell dips below this.
            </HelpIcon>
          </span>
          <div class="smart-input-wrap w-[75px]">
            <input id="sys-cutoff" type="number" value="3.00" step="0.05" />
            <span class="unit">V</span>
          </div>
        </div>
        <div class="flex justify-between items-center mt-0.5">
          <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">LVC (Pack)</span>
          <div class="smart-input-wrap w-[75px]">
            <input id="sys-cutoff-pack" type="number" value="30.0" step="0.5" />
            <span class="unit">V</span>
          </div>
        </div>
      </div>
      <div id="row-usable-cap" class="res-row flex justify-between items-baseline min-h-4 mt-1">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Usable Cap</span>
        <span id="out-sim-usable" class="res-val font-mono font-bold text-[0.75rem] c-teal">100%</span>
      </div>
      <div id="row-runtime" class="res-row flex justify-between items-baseline min-h-4">
        <span id="lbl-runtime" class="res-lbl text-slate-500 font-semibold text-[0.68rem] flex items-center">
          Runtime
          <HelpIcon position="right" align="left">
            Estimated time until battery hits LVC or 0% SoC.
          </HelpIcon>
        </span>
        <span id="out-sim-runtime" class="res-val font-mono font-bold text-[0.75rem] c-dark">--</span>
      </div>
    </div>
    <div class="w-px bg-slate-100 my-1"></div>
    <div class="res-col p-1.5 px-2.5 flex flex-col gap-0.5">
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Current</span>
        <span id="out-sim-amps" class="res-val font-mono font-bold text-[0.75rem] c-indigo">0.0 A</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Total Pwr</span>
        <span id="out-sim-power-total" class="res-val font-mono font-bold text-[0.75rem] c-violet">0 W</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Useful Pwr</span>
        <span id="out-sim-power-useful" class="res-val font-mono font-bold text-[0.75rem] c-blue">0 W</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4 mt-1">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Heat (cells)</span>
        <span id="out-sim-heat-cell" class="res-val font-mono font-bold text-[0.75rem] c-orange">0 W</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Heat (strips)</span>
        <span id="out-sim-heat-strip" class="res-val font-mono font-bold text-[0.75rem] c-red">0 W</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4">
        <span class="res-lbl font-bold text-app-red-dark">Total Waste</span>
        <span id="out-sim-heat-total" class="res-val font-mono font-extrabold text-[0.75rem] c-red">0 W</span>
      </div>
      <div class="res-row flex justify-between items-baseline min-h-4 mt-auto pt-1 border-t border-dashed border-slate-100">
        <span class="res-lbl text-slate-500 font-semibold text-[0.68rem]">Efficiency</span>
        <span id="out-sim-eff" class="res-val font-mono font-bold text-[0.75rem] c-green">100%</span>
      </div>
      <div id="row-status" class="res-row flex justify-end items-center min-h-[14px]">
        <span id="status-text" class="text-app-red font-extrabold text-[0.7rem] hidden">⚠️ CUTOFF</span>
      </div>
    </div>
  </div>
</section>
