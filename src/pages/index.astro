---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import RenderArea from '../components/RenderArea.astro';
import DiagnosticPanel from '../components/DiagnosticPanel.astro';
import SnapshotArea from '../components/SnapshotArea.astro';
import StatsPanel from '../components/StatsPanel.astro';
import CellSpecsSection from '../components/sidebar/CellSpecsSection.astro';
import ChemistrySection from '../components/sidebar/ChemistrySection.astro';
import PackConfigSection from '../components/sidebar/PackConfigSection.astro';
import SimulationSection from '../components/sidebar/SimulationSection.astro';
import BmsSelectorSection from '../components/sidebar/BmsSelectorSection.astro';
import BmsBoxSection from '../components/sidebar/BmsBoxSection.astro';
import PowerConnectorSection from '../components/sidebar/PowerConnectorSection.astro';
import StandardsSection from '../components/sidebar/StandardsSection.astro';
import BreakerSection from '../components/sidebar/BreakerSection.astro';
import ThermalSection from '../components/sidebar/ThermalSection.astro';
import CoolingSection from '../components/sidebar/CoolingSection.astro';
import EnclosureSection from '../components/sidebar/EnclosureSection.astro';
import DegradationSection from '../components/sidebar/DegradationSection.astro';
import BalancingSection from '../components/sidebar/BalancingSection.astro';
import ParallelSection from '../components/sidebar/ParallelSection.astro';
import TcoSection from '../components/sidebar/TcoSection.astro';
import IoTSection from '../components/sidebar/IoTSection.astro';
import VisualSettingsSection from '../components/sidebar/VisualSettingsSection.astro';
import AboutSection from '../components/sidebar/AboutSection.astro';
import DisclaimerModal from '../components/modals/DisclaimerModal.astro';
import LicenseModal from '../components/modals/LicenseModal.astro';
import FeedbackModal from '../components/modals/FeedbackModal.astro';
import CommercialModal from '../components/modals/CommercialModal.astro';
import ExportModal from '../components/modals/ExportModal.astro';
import StepExportModal from '../components/modals/StepExportModal.astro';
import SvgExportModal from '../components/modals/SvgExportModal.astro';
import CompareModal from '../components/modals/CompareModal.astro';
import CustomBmsModal from '../components/modals/CustomBmsModal.astro';
  import BomModal from '../components/modals/BomModal.astro';
  import DatasheetModal from '../components/modals/DatasheetModal.astro';
---

<Layout
  title="Battery Tool | 3D Design & Calculation Tool"
  description="Free 3D Battery Pack Simulator and Designer. Calculate voltage sag, heat, and efficiency for 18650/21700 packs. Export to STL for 3D printing."
>
  <aside
    id="sidebar"
    class="w-[380px] h-full flex flex-col z-20 flex-shrink-0 max-md:w-full max-md:h-[75vh] max-md:order-1 max-md:border-r-0"
    style="background: var(--bg-secondary); border-color: var(--border-primary); border-width: 0 1px 0 0; border-style: solid; box-shadow: 4px 0 20px rgba(0,0,0,0.03);"
  >
    <div id="controls-container" class="flex-1 overflow-y-auto overflow-x-hidden">
      <Header />

      <div class="px-[15px] pt-2.5">
        <label class="control-label" for="pack-name">Configuration Name</label>
        <input
          id="pack-name"
          type="text"
          value="My Custom Pack"
          placeholder="e.g. Long Range V1"
          class="control-input"
        />
      </div>

      <CellSpecsSection />
      <ChemistrySection />
      <PackConfigSection />
      <SimulationSection />
      <BmsSelectorSection />
      <BmsBoxSection />
      <PowerConnectorSection />
      <StandardsSection />
      <BreakerSection />
      <BalancingSection />
      <ParallelSection />
      <TcoSection />
      <IoTSection />
      <ThermalSection />
      <CoolingSection />
      <EnclosureSection />
      <DegradationSection />
      <VisualSettingsSection />
      <AboutSection />
    </div>

    <SnapshotArea />
    <StatsPanel />
  </aside>

  <RenderArea />

  <DiagnosticPanel />

  <CompareModal />
  <LicenseModal />
  <DisclaimerModal />
  <FeedbackModal />
  <CommercialModal />
  <ExportModal />
  <StepExportModal />
  <SvgExportModal />
  <CustomBmsModal />
  <BomModal />
  <DatasheetModal />

  <script>
    import { initApp } from '../scripts/app';
    initApp();
  </script>
</Layout>
